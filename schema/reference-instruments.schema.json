{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Register seed — reference instruments",
  "type": "object",
  "required": ["instruments"],
  "properties": {
    "$schema": { "type": "string" },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "code", "description", "venue", "quoteUnit"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
          "type": { "type": "string", "enum": ["Index", "ReferenceRate", "Basket", "Synthetic"] },
          "code": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "venue": { "type": "string", "pattern": "^[A-Z0-9]{4}$" },
          "board": { "type": "string", "minLength": 1 },
          "quoteUnit": { "type": "string", "enum": ["Currency", "Points", "PercentOfFace", "PercentPerAnnum"] },
          "settlementAsset": { "type": "string", "minLength": 1 },
          "methodology": { "type": "string" },
          "provider": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
